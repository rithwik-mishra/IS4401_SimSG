#openai or soclaas
SIMSG_PROVIDER=openai

#if using openai, specify the model to use
OPENAI_API_KEY=
SIMSG_MODEL=gpt-4.1-mini

#if using soclaas, specify the base url, api key and model to use
SOCLAAS_BASE_URL="https://soclaas-api.comp.nus.edu.sg/v1"
SOCLAAS_API_KEY=
SOCLAAS_MODEL=default

# CORS Configuration (optional comma-separated list of allowed origins)
# Vercel preview and production deployments (*.vercel.app) are automatically permitted
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting Configuration
# Maximum simulation requests per hour per session ID (default: 10)
RATE_LIMIT_PER_HOUR=10
